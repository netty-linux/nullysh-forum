{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://nullysh.com",
          "https://www.nullysh.com",
          "https://nullysh-forum.ngdigitalsuporte.workers.dev",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
