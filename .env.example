# Supabase (auth / storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Telegram Bot = storage da aba Vídeos ───────────────────────────
# 1. Crie um bot com @BotFather → copie o token
# 2. Crie um canal/grupo privado (recomendado: canal)
# 3. Adicione o bot como admin do canal
# 4. Descubra o chat_id:
#    - Encaminhe uma msg do canal para @userinfobot ou
#    - Use getUpdates após postar algo no canal, ou
#    - IDs de canal costumam ser negativos (ex.: -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_STORAGE_CHAT_ID=

# Protege upload/delete de vídeos em produção (header x-admin-secret).
# Em desenvolvimento local, o painel ADM usa x-admin-role: admin.
ADMIN_API_SECRET=

# Opcional: espelha o secret no client (só se precisar de upload fora do dev).
# Prefira não expor em produção pública.
# NEXT_PUBLIC_ADMIN_API_SECRET=
# NEXT_PUBLIC_ADMIN_SECRET=

# Preview cloud: permite admin via headers x-admin-role
ALLOW_HEADER_ADMIN=1

# ── Cloudflare R2 (playback de vídeos) ─────────────────────────
# 1. Dashboard → R2 → Enable
# 2. Bucket: nullysh-videos (binding VIDEOS_BUCKET no wrangler.jsonc)
# 3. (Opcional, presign S3 direto) R2 → Manage R2 API Tokens → Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nullysh-videos

# Giphy (GIFs no bate-papo). Sem key → catálogo local de memes populares.
# Crie em https://developers.giphy.com/
NEXT_PUBLIC_GIPHY_API_KEY=

# Server-only � Pay fulfillment VIP (nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=


# Nullysh Pay (producao)
NULLYSH_PAY_URL=https://pay.nullysh.com
NEXT_PUBLIC_NULLYSH_PAY_URL=https://pay.nullysh.com

# SSO unificado (issue/exchange de code) — NÃO reutilizar no HMAC Matriz
NULLYSH_PAY_SSO_SECRET=

# HMAC Matriz: checkout platform, fulfillment VIP/NullPass, nullpass-resolve, status
# Gere valor distinto do SSO (min 16 chars). Mesmo valor no Worker do Pay.
NULLYSH_MATRIX_HMAC_SECRET=

# Service role — fulfillment VIP (Supabase). NullPass usa D1 nullysh-forum-db.
SUPABASE_SERVICE_ROLE_KEY=
