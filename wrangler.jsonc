{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nullysh-forum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nullysh-forum"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NULLYSH_DATA",
      "id": "9982b19bc1634effa79a756043be2c4f"
    }
  ],
  // Habilite R2 no dashboard Cloudflare antes do próximo deploy:
  // https://dash.cloudflare.com → R2 → Enable
  "r2_buckets": [
    {
      "binding": "VIDEOS_BUCKET",
      "bucket_name": "nullysh-videos"
    }
  ],
  "d1_databases": [
    {
      "binding": "NULLYSH_FORUM_DB",
      "database_name": "nullysh-forum-db",
      "database_id": "c0101283-d2e0-48dc-9729-96a4ae0d7283"
    }
  ],
  "workers_dev": true,
  "vars": {
    "NEXT_PUBLIC_NULLYSH_PAY_URL": "https://pay.nullysh.com",
    "NULLYSH_PAY_URL": "https://pay.nullysh.com"
  },
  // Rotas de zona (não custom_domain) — requer zona nullysh.com na mesma conta
  "routes": [
    { "pattern": "nullysh.com/*", "zone_name": "nullysh.com" },
    { "pattern": "www.nullysh.com/*", "zone_name": "nullysh.com" }
  ],
  "observability": {
    "enabled": true
  }
}
